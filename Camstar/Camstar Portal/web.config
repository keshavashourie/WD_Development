    <!--
            The <authentication> section enables configuration 
            of the security authentication mode used by 
            ASP.NET to identify an incoming user. 
        -->
    <authentication mode="Forms">
      <forms name=".INSITEPORTALAUTH" loginUrl="Default.aspx" defaultUrl="Main.aspx"
        timeout="200" requireSSL="true" slidingExpiration="true" cookieless="UseCookies"
        cookieSameSite="None" />
    </authentication>
    <authorization>
      <allow users="*">
      </allow>
    </authorization>
    <sessionState mode="InProc" stateConnectionString="tcpip=127.0.0.1:42424" sqlConnectionString="data source=127.0.0.1;user id=sa;password=" cookieless="false" timeout="20" cookieSameSite="None">
    </sessionState>
    <customErrors mode="RemoteOnly" defaultRedirect="CamstarErrorPage.aspx" redirectMode="ResponseRewrite">
      <error statusCode="404" redirect="PageNotFound.aspx">
      </error>
    </customErrors>
