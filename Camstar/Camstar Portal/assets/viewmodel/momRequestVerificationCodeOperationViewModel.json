{
    "schemaVersion": "1.0.0",
    "imports": [
        "js/aw-include.directive",
        "js/aw-icon.directive",
        "js/aw-link.directive",
        "js/aw-button.directive",
        "js/aw-widget.directive",
        "js/aw-label.directive",
        "js/aw-enter-key.directive",
        "js/aw-command-panel.directive",
        "js/visible-when.directive",
        "js/enable-when.directive",
        "js/aw-panel-body.directive",
        "js/aw-command-panel-section.directive",
        "js/aw-panel-footer.directive"
    ],
    "data": {},
    "actions": {
        "requestVerificationCode": {
            "actionType": "Event",
            "method": "Event",
            "inputData": {
                "events": [{
                    "condition": "conditions.isValidRequestVerificationCodeOperationForm",
                    "name": "mom.login.onVerificationCodeRequested",
                    "eventData": {
                        "data": "{{subPanelContext}}"
                    },
                    "excludeLocalDataCtx": true
                }]
            }
        },
        "cancelRequestVerificationCode": {
            "actionType": "Event",
            "method": "Event",
            "inputData": {
                "events": [{
                    "name": "mom.login.onRequestVerificationCodeCanceled",
                    "eventData": {
                        "data": "{{subPanelContext}}"
                    },
                    "excludeLocalDataCtx": true
                }]
            }
        }
    },
    "onEvent": [],
    "conditions": {
        "isValidRequestVerificationCodeOperationForm": {
            "expression": "ctx.momValidRequestVerificationCodeOperationForm"
        },
        "validRequestVerificationCodeData": {
            "expression": "!subPanelContext.email.validationCriteria[0]"
        }
    },
    "i18n": {}
}
