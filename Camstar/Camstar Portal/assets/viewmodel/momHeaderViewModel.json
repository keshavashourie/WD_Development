{
    "schemaVersion": "1.0.0",
    "imports": [
        "js/aw-column.directive",
        "js/aw-row.directive",
        "js/visible-when.directive",
        "js/aw-tab-set.directive",
        "js/exist-when.directive",
        "js/aw-class.directive",
        "js/mom-modal-overlay.directive",
        "js/aw-layout-slot.directive"
    ],
    "data": {},
    "actions": {
        "init": {
            "actionType": "JSFunction",
            "method": "init",
            "deps": "js/mom.layout.service",
            "inputData": {},
            "outputData": {}
        },
        "setMomPageEntity": {
            "actionType": "JSFunction",
            "method": "setMomPageEntity",
            "deps": "js/mom.layout.service",
            "inputData": {
            },
            "outputData": {}
        },
        "toggleCommandLabels": {
            "actionType": "JSFunction",
            "method": "toggleCommandLabels",
            "deps": "js/mom.layout.service",
            "inputData": {
                "value": "{{ctx.toggleLabel}}"
            },
            "outputData": {}
        },
        "setHeaderViewModel": {
            "actionType": "JSFunction",
            "method": "setHeaderViewModel",
            "deps": "js/mom.layout.service",
            "inputData": {
                "value": "{{ctx.momPageEntity}}"
            },
            "outputData": {
                "headerViewModel": "headerViewModel"
            }
        }
    },
    "dataProviders": {},
    "functions": {},
    "onEvent": [ {
        "eventId": "momHeader.contentLoaded",
        "action": "init"
    }, {
        "eventId": "momHeader.contentLoaded",
        "action": "setMomPageEntity"
    },{
        "eventId": "momHeader.contentLoaded",
        "action": "toggleCommandLabels"
    }, {
        "eventId": "appCtx.*",
        "action": "setHeaderViewModel",
        "condition": "name === 'momPageEntity'"
    },
    {
        "eventId": "appCtx.*",
        "action": "toggleCommandLabels",
        "condition": "name === 'toggleLabel'"
    } ],
    "i18n": {},
    "messages": {},
    "conditions": {}
}
