{
    "schemaVersion": "1.0.0",
    "imports": [
        "js/aw-popup2.directive",
        "js/aw-panel-body.directive",
        "js/aw-panel-footer.directive",
        "js/exist-when.directive",
        "js/aw-button.directive",
        "js/aw-include.directive",
        "js/aw-command-bar.directive",
        "js/aw-splm-table.directive",
        "js/aw-row.directive",
        "js/aw-command.directive",
        "js/aw-advanced-bar.directive",
        "js/aw-flex-row.directive",
        "js/aw-flex-column.directive",
        "js/exist-when.directive",
        "js/aw-search-box.directive"

    ],
    "actions": {
        "doCompactSearch": {
            "actionType": "JSFunction",
            "method": "doCompactSearch",
            "inputData": {
                "filterInput": {
                    "searchInput": "{{data.searchCompactBox}}"
                }
            },
            "deps": "js/mom.acb.component.service"
        },
        "openCompactSortMenu": {
            "actionType": "JSFunction",
            "method": "openCompactSortMenu",
            "inputData": {
                "controlId": "{{data.controlId}}"
            },
            "deps": "js/mom.acb.component.service"
        }
    },
    "data": {
        "searchCompactBoxPlaceHolder": {
            "dbValue": "Search"
        },
        "searchCompactBox": {
            "displayName": "Search",
            "type": "STRING",
            "isEnabled": true
        }
    },
    "i18n": {
        "close": [ "momMessages" ]
    },
    "onEvent": [ {
        "eventId": "momCompactACB.contentLoaded",
        "action": "openCompactSortMenu"
    }
 ]
}
