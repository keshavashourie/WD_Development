<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<ExcludeSuperClass>
		<!--Example: <CDOSuperClass name="NamedDataObject"></CDOSuperClass>-->
	</ExcludeSuperClass>

	<ExcludeSingleClass>
		<!--Example: <CDOSingleClass name="MfgOrder"></CDOSingleClass>-->
	</ExcludeSingleClass>

	<PurgeTables>
		<!--Container-->
		<Table>
			<SetupTable>HistoryMainline</SetupTable>
			<SetupColumn>HistoryId</SetupColumn>
			<ParentTable>Container</ParentTable>
			<ParentColumn>ContainerId</ParentColumn>
		</Table>
		<Table>
			<SetupTable>CurrentStatus</SetupTable>
			<SetupColumn>CurrentStatusId</SetupColumn>
			<ParentTable>Container</ParentTable>
			<ParentColumn>CurrentStatusId</ParentColumn>
			<ParentColumnIsPrimaryKey>false</ParentColumnIsPrimaryKey>
		</Table>
    <!--MfgOrder-->
		<Table>
			<SetupTable>ChangeStatus</SetupTable>
			<SetupColumn>ParentId</SetupColumn>
			<ParentTable>MfgOrder</ParentTable>
			<ParentColumn>MfgOrderId</ParentColumn>
		</Table>
		<Table>
			<SetupTable>WIPMsgDefMgr</SetupTable>
			<SetupColumn>ParentId</SetupColumn>
			<ParentTable>MfgOrder</ParentTable>
			<ParentColumn>MfgOrderId</ParentColumn>
		</Table>
    <!--Event-->
    <Table>
      <SetupTable>HistoryMainline</SetupTable>
      <SetupColumn>HistoryId</SetupColumn>
      <ParentTable>Event</ParentTable>
      <ParentColumn>EventId</ParentColumn>
    </Table>
    <Table>
      <SetupTable>EventDisallowedTxns</SetupTable>
      <SetupColumn>EventId</SetupColumn>
      <ParentTable>Event</ParentTable>
      <ParentColumn>EventId</ParentColumn>
    </Table>
  </PurgeTables>
</configuration>