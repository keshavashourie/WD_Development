<?xml version="1.0"?>
<Sites>
  <Site name="OpcenterSemi">
    <InSiteServers>
      <InSiteServer name="EXSM">
        <Hostname>localhost</Hostname>
        <Port>443</Port>
        <DisplayName>EXSM</DisplayName>
      </InSiteServer>
    </InSiteServers>
    <Configuration>
      <Domain>.</Domain>
      <AllowCaseSensitive>true</AllowCaseSensitive>
      <AllowXMLSignature>false</AllowXMLSignature>
      <DataCacheTTL>60</DataCacheTTL>
      <DataCacheSizeWarningEnabled>true</DataCacheSizeWarningEnabled>
      <DataCacheUpdateWarningEnabled>true</DataCacheUpdateWarningEnabled>
      <DataCacheSizeWarningCount>100000</DataCacheSizeWarningCount>
      <DataCacheUpdateWarningCount>500</DataCacheUpdateWarningCount>
      <DataCacheSuggestionEnabled>true</DataCacheSuggestionEnabled>
      <DataCacheSuggestionLoadCount>100</DataCacheSuggestionLoadCount>
      <SchedPollInterval>10</SchedPollInterval>
      <SummaryTableLocation>DataStore Database Only</SummaryTableLocation>
      <EnableCleanup>true</EnableCleanup>
      <ConnectionTimeout>300</ConnectionTimeout>
      <LogCleanup>false</LogCleanup>
      <MaxRowsetSize>15000</MaxRowsetSize>
      <RBACPasswordExpirationWarning>14</RBACPasswordExpirationWarning>
      <RBACIdleSessionTimeout>30</RBACIdleSessionTimeout>
      <AuthenticationType>AD</AuthenticationType>
      <UseSSLWithLDAP>false</UseSSLWithLDAP>
      <LDAPServer />
      <LDAPOrgUnit />
      <EnableLoginCaching>true</EnableLoginCaching>
      <NeverFlushLogin>false</NeverFlushLogin>
      <LoginCacheTTL>60</LoginCacheTTL>
      <EmailNotificationPollInterval>1</EmailNotificationPollInterval>
      <EmailNotificationRetryCount>1</EmailNotificationRetryCount>
      <EmailNotificationFailureRetryWaitTime>10</EmailNotificationFailureRetryWaitTime>
      <EmailNotificationRetentionPeriod>1</EmailNotificationRetentionPeriod>
      <EmailNotificationFailureRetentionPeriod>72</EmailNotificationFailureRetentionPeriod>
      <UserLicenseAllocation>-1</UserLicenseAllocation>
      <LicenseServer>29000@192.168.1.41</LicenseServer>
      <AltLicenseServer />
      <LicExpNotificationsEnabled>false</LicExpNotificationsEnabled>
      <LicExpEarlyWarningDays>60</LicExpEarlyWarningDays>
      <LicExpCriticalWarningDays>30</LicExpCriticalWarningDays>
      <LicExpEmailRecipients />
      <LicExpEmailSender />
      <LicenseServerType>SaltServer</LicenseServerType>
      <LicenseFileType>Ugslmd</LicenseFileType>
      <RestUserName>Camstaradmin</RestUserName>
      <RestPassword>3C55CF1CD27B56324841493CCDD7ADAB</RestPassword>
      <RestLogsPath>C:\Temp\</RestLogsPath>
      <RestXmlLogsEnabled>false</RestXmlLogsEnabled>
      <RestTxnLogsEnabled>false</RestTxnLogsEnabled>
      <RestErrorLogsEnabled>true</RestErrorLogsEnabled>
      <CORSWhitelist>,http://localhost:8080,http://localhost:8081</CORSWhitelist>
    </Configuration>
    <MetadataDBConfig>
      <MetaFilename>C:\Program Files (x86)\Camstar\InSite Administration\InSiteSemi.mdb</MetaFilename>
      <SiteInfoFilename>C:\Program Files (x86)\Camstar\InSite Administration\SiteInfo.mdb</SiteInfoFilename>
    </MetadataDBConfig>
    <TransactionDBConfig>
      <DSN />
      <DBName>exsm</DBName>
      <Schema>exsm_schema</Schema>
      <User>exsm_login</User>
      <Password>3C55CF1CD27B56324841493CCDD7ADAB</Password>
      <NumSites>1</NumSites>
      <SiteID>1</SiteID>
      <WarningRange>500000</WarningRange>
      <DBType>SQLServer</DBType>
      <DBHostName>localhost</DBHostName>
      <DBPort>1433</DBPort>
      <ConnectionParameters>Port=1433</ConnectionParameters>
      <CertHostName />
      <CertFile />
      <EncryptConnection>false</EncryptConnection>
      <ValidateCertificate>false</ValidateCertificate>
      <ValidateCertificateHostname>false</ValidateCertificateHostname>
    </TransactionDBConfig>
  </Site>
</Sites>